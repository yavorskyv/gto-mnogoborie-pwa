# Почта платформы «Многоборье ГТО» — пример настроек для web/api_server.js
# Скопируйте в .env на сервере и экспортируйте переменные перед запуском (systemd EnvironmentFile / pm2 env).
# Пока MAIL_ENABLED не равен 1, письма только пишутся в data/mail_log.json (dry-run), сайт работает как раньше.

MAIL_ENABLED=0

# --- Вариант A: Яндекс 360 для бизнеса (ящик на своём домене) ---
# Логин — ПОЛНЫЙ адрес ящика; пароль — «пароль приложения» с id.yandex.ru/security → «Пароли приложений» → «Почта»
# (в ящике должен быть включён доступ «С сервера imap.yandex.ru по протоколу IMAP»; пароль начинает работать через 2–3 часа).
# Лимит: 300 писем (получателей) в сутки с одного ящика, одинаков для всех тарифов.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=noreply@gto.com.ru
SMTP_PASS=пароль-приложения

# --- Вариант B: Yandex Cloud Postbox (транзакционная отправка, 2 000 писем/мес бесплатно) ---
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=<ID API-ключа сервисного аккаунта с ролью postbox.sender>
# SMTP_PASS=<секрет API-ключа>

# --- Вариант C: VK WorkSpace (бесплатно до 5 ящиков) ---
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=noreply@gto.com.ru
# SMTP_PASS=<пароль для внешних приложений>

# Отправитель и адрес федерации для уведомлений (несколько адресов через запятую)
MAIL_FROM=Федерация многоборья ГТО <noreply@gto.com.ru>
MAIL_ADMIN=info@gto.com.ru

# Предохранитель: не больше N получателей в сутки (чуть ниже лимита провайдера)
MAIL_DAILY_LIMIT=280

# Локальная разработка с Mailpit/MailHog (только 127.0.0.1, без TLS)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=0
# SMTP_LOOPBACK_PLAINTEXT=1
